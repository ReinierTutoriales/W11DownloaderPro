{
  "manifest_version": 3,
  "name": "W11DownloaderPro",
  "version": "0.1.0",
  "description": "Captura descargas y enlaces de archivos y los envía al acelerador W11DownloaderPro.",
  "browser_specific_settings": {
    "gecko": {
      "id": "w11dl@reiniertutoriales",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "contextMenus",
    "cookies",
    "downloads",
    "nativeMessaging",
    "notifications",
    "scripting",
    "activeTab",
    "storage",
    "webRequest",
    "webRequestBlocking"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "lib/core.js",
      "background.js"
    ]
  },
  "action": {
    "default_title": "W11DownloaderPro",
    "default_popup": "popup/popup.html"
  }
}
